# Copy to .env and adjust. All settings use the AML_ prefix.
AML_RAW_DATA_DIR=data/raw
AML_TRANSACTIONS_FILE=HI-Small_Trans.csv
AML_PATTERNS_FILE=HI-Small_Patterns.txt
AML_PROCESSED_DATA_DIR=data/processed
AML_DUCKDB_PATH=data/aml.duckdb
AML_AUDIT_DB_PATH=data/audit.sqlite

# fake | anthropic | bedrock | openai
AML_LLM_PROVIDER=fake
# Model IDs live here, never in code. Leave blank for the fake provider.
AML_MODEL_ID=
AML_AWS_REGION=

# Train = rows before this date. Sep 1-7 holds 73.5% of HI-Small rows (see docs/PROGRESS.md).
AML_TRAIN_TEST_SPLIT_DATE=2022-09-08
AML_CUSTOMER_SEED=42

# Alerting (Phase 2): tuned thresholds are written to $AML_ARTIFACTS_DIR/thresholds.json
AML_ARTIFACTS_DIR=artifacts
AML_ALERT_BUDGET_PER_1K_WINDOWS=10
